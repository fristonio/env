	email = deepeshpathak09@gmail.com
	username = fristonio
	signingkey = ~/.ssh/id_ed25519.pub

[core]
	editor = vim
	fileMode = false
	autocrlf = false
	pager = delta

[pull]
	ff = only

[init]
	defaultBranch = main

[branch]
	sort = -committerdate

[gpg]
	format = ssh

[safe]
	directory = *

[worktree]
	useRelativePath = true

[include]
	path = ~/.config/delta.gitconfig

[alias]
	hdiff = "-c core.pager=\"hunk pager\" diff"
	hshow = "-c core.pager=\"hunk pager\" show"
